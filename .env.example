# Next.js server-side proxy. The model service binds to loopback.
CAMPUS_API_URL=http://127.0.0.1:8000
# Optional Python settings must be exported before starting scripts/dev.sh:
# CAMPUS_DATA_DIR=/absolute/path/to/local-private-state
# CAMPUS_DEMO_PASSWORD=your-local-demo-password
# Changing the password only affects newly initialized accounts.
